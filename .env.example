# Local launcher sets MATHS_MODE=local and binds only 127.0.0.1.
# For hosted deployment, set ALL of these in the hosting environment:
MATHS_MODE=hosted
MATHS_APP_URL=https://your-domain.example
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Required public parent contact before opening invitation requests.
MATHS_CONTACT_EMAIL=
